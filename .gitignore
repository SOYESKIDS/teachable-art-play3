# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# 실제 값이 없는 예시 파일만 opt-in 한다 (위 주석의 "can opt-in" 경로).
# 이 파일에는 변수 이름만 있고 secret 값은 들어가지 않는다.
!.env.example

# Local source image library
/image-library/
