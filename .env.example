# TeachAble Art Play — 환경변수 예시
#
# 실제 값은 .env.local 에만 두고 절대 커밋하지 않는다.
# 이 파일에는 "어떤 변수가 필요한가"만 적는다.

# ── Supabase ─────────────────────────────────────────────────────────
# 공개해도 안전한 값. RLS 가 최종 보안 계층이다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. Auth Admin 작업(원장 초대 등)에만 쓴다.
# 일반 DB 작업에는 쓰지 않는다 — src/lib/supabase/admin.ts 주석 참조.
SUPABASE_SECRET_KEY=

# ── E단계  주차 교안을 어디서 읽을까 ─────────────────────────────────
# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다 (클라이언트가 바꾸면 안 된다).
#
#   fixture   저장소 안의 전사본을 읽는다. **기본값** — 비워 두거나 다른 값이면 이것이다.
#   database  DB(lesson_sections.body_json · lesson_scenes)에서 읽는다.
#
# 허용값은 위 둘뿐이다. 오타는 조용히 fixture 로 떨어진다 —
# 부르는 쪽이 깜빡했을 때 지금 동작하는 쪽으로 가기 위해서다.
#
# ★ 이 값은 **배포 하나에 하나**다. 역할·사용자·요청별로 나뉘지 않는다.
#   따라서 「교사는 fixture · 본사는 database」를 **한 배포에서 동시에 쓸 수 없다.**
#   검수용으로 database 를 쓰려면 배포를 따로 둔다 (docs/staging-flow-readiness.md).
#
# ⚠️ database 로 두기 전에 **반드시** 먼저 끝나 있어야 하는 것:
#     1) migration e1 · e2 · e3 · e4 적용  (선행 m1 계열 포함)
#     2) supabase/content/tap24_2026_1_load.sql 적재
#     3) 본사 검수 → 발행 (적재 직후는 draft 다)
#   하나라도 빠진 채 database 로 두면 교사 · 교실 화면이 **빈 화면이 아니라
#   오류 화면**을 띄운다. fixture 로 조용히 대체하지 않기 때문이다 —
#   저장된 것과 다른 내용으로 수업하는 쪽이 더 나쁘다.
#
# ★ 적재 직후 draft 상태에서 정식 교사 · 교실 경로가 막히는 것은 **정상**이다.
#   화면을 열려고 임의 발행하거나 발행 게이트를 우회하지 않는다.
#   검수 중인 내용을 보려면 본사 검수 경로(/admin/curriculum/weeks/...)를 쓴다.
CONTENT_SOURCE=fixture

# ── SERVICE-10A  AI 관찰기록 정리 ────────────────────────────────────
# 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
#
# 둘 중 하나라도 비어 있으면 AI 정리 기능만 비활성화되고
# 나머지 화면(출결·관찰기록·활동사진)은 그대로 동작한다.
#
# OPENAI_OBSERVATION_MODEL 은 코드에 하드코딩하지 않는다.
# 모델을 바꿀 때 배포 없이 환경변수만 바꿀 수 있어야 하기 때문이다.
OPENAI_API_KEY=
OPENAI_OBSERVATION_MODEL=

# ── SERVICE-11B  AI 성장 리포트 초안 ─────────────────────────────────
# 선택 항목이다. 비워 두면 OPENAI_OBSERVATION_MODEL 을 그대로 쓴다.
# 성장 리포트만 다른 모델로 돌리고 싶을 때만 채운다.
OPENAI_GROWTH_REPORT_MODEL=

# ── PHASE 07  G-2 임시 rollout switch (교사 · 원장 기본 화면 계열) ─────────
# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# "true" 일 때만 SaaS 2.0 교사 · 원장 화면(Class Mode · Observation 2.0 · Weekly)이 기본 경로가 된다.
# 비워 두거나 다른 값이면 legacy 운영 화면이 기본이다 (Production 기본).
# 화면 계열만 고른다 — 권한 · entitlement 판정은 바꾸지 않는다. Runbook Step J 이후 제거한다.
# staging · local 에서 SaaS 2.0 화면을 점검할 때만 true 로 둔다.
SOYE_SAAS_V2_APP_CUTOVER=

# ── 실행 묶음 E  배포 환경 가드 (src/lib/env/deployment-guard.ts) ────────
# 전부 선택 항목이다. 비워 두면 가드가 아무것도 바꾸지 않는다.
#
# 운영 Supabase 프로젝트의 ref (URL 의 <ref>.supabase.co 부분).
# 이 값이 있어야 "비운영 배포가 운영 데이터를 쓰고 있다"를 판정할 수 있다.
# 없으면 판정하지 않는다 — 추측으로 단정하지 않기 위해서다.
SUPABASE_PRODUCTION_PROJECT_REF=
#
# SUPABASE_SECRET_KEY 가 어느 프로젝트의 키인지 선언한다.
# Supabase 의 새 secret key 는 문자열 안에 ref 를 담지 않아 키만으로는 대조할 수 없다.
# 이 값이 있으면 URL 의 ref 와 대조해 세트 불일치를 잡는다.
SUPABASE_SECRET_KEY_PROJECT_REF=
#
# "1" 이면 비운영 배포(Preview · 로컬)가 운영 프로젝트에 쓰는 것을 차단한다.
# 기본값(빈 값)은 꺼짐이다. 운영 배포에서는 이 값과 무관하게 항상 통과한다 —
# 실제 운영 상담 접수를 막지 않기 위해서다.
#
# ★ 켠 뒤 비운영 배포의 판정은 세 갈래다.
#     운영이라고 확인됨      → 막는다
#     운영이 아니라고 확인됨 → 통과 (정상 스테이징 쓰기)
#     **확인하지 못함        → 막는다**
#   그래서 이 값을 "1" 로 두려면 SUPABASE_PRODUCTION_PROJECT_REF 도 함께 둬야 한다.
#   빠뜨리면 쓰기가 전부 막힌다 — 「켜 뒀는데 사실은 안 막히고 있었다」보다 낫다.
#
# 적용 범위는 **서버 쓰기 경로 전부**다. 공개 상담 폼도 Server Action 을 지나므로
# 포함된다 (src/lib/public/lead-submit-actions.ts). 브라우저에서 직접 쓰는 경로는
# 남아 있지 않으며, 활동 사진의 Storage 직접 업로드는 **준비 단계 Server Action**
# 에서 막아 업로드가 시작되지 않게 한다.
BLOCK_WRITES_ON_PRODUCTION_DATA=

# ── 실행 묶음 C3  보호자 공유 링크 조회 제한 ─────────────────────────
# 서버 전용. 16자 이상의 임의 문자열. 값 자체는 어디에도 적지 않는다.
# IP 를 그대로 해시하면 IPv4 는 전수 탐색이 가능하므로 salt 를 섞는다.
# 비워 두면 rate limit 을 걸 수 없으므로 보호자 공유 조회를 **제공하지 않는다**.
# 사유는 서버 로그에만 남는다 (제한 적용으로 보고하지 않는다).
#
# 코드의 실제 조건 (src/lib/share/portal-throttle.ts):
#   `!salt || salt.length < 16` 이면 지문을 만들지 않고 → 조회를 막는다 (fail-closed).
#   15자도 미설정과 같게 다룬다. 길이만 보고 내용은 검사하지 않는다.
#   migration c3(portal_access_throttle) 미적용으로 RPC 가 없을 때도 같게 막힌다.
PORTAL_THROTTLE_SALT=
#
# ⚠️ 배포 전제 — 비워 두면 보호자 공유 링크(신규 Portal · 기존 성장리포트 공유)가
#    열리지 않는다. 제한을 걸 수 없는 상태에서 민감 기록을 제공하지 않기 때문이다.
